:root {
  --ink: #171513;
  --surface-dark: #211e1b;
  --cream: #f6f1e7;
  --card-cream: #fffaf3;
  --orange: #e7481c;
  --orange-dark: #ba3514;
  --muted: #6e665d;
  --border-warm: #e2d7c7;
  --header-height: 90px;
}

* {
  box-sizing: border-box;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

html {
  scroll-behavior: smooth;
  font-kerning: normal;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  overflow-x: clip;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

/* Top Navigation - Sticky Persistent Banner */
.top {
  height: 90px;
  background: #fffaf1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px max(5%, calc((100vw - 1300px) / 2));
  gap: 20px;
  position: sticky;
  top: 0;
  z-index: 900;
  border-bottom: 1px solid #ddd4c6;
}

.brand img {
  width: 205px;
  max-height: 64px;
  height: auto;
  object-fit: contain;
  display: block;
}

.top nav {
  display: flex;
  gap: 30px;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 1px;
}

.top nav a {
  transition: color 0.2s ease;
}

.top nav a:hover,
.textlink:hover {
  color: var(--orange);
}

/* Buttons */
.button {
  display: inline-block;
  background: var(--orange);
  color: #ffffff;
  padding: 18px 26px;
  font-weight: 900;
  font-size: 13px;
  letter-spacing: 1px;
  border: 2px solid var(--orange);
  border-radius: 3px;
  transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  cursor: pointer;
}

.button:hover {
  background: var(--orange-dark);
  border-color: var(--orange-dark);
}

.button.small {
  padding: 12px 18px;
}

.button.button-muted {
  background: #6b635a;
  border-color: #6b635a;
}

.button.button-muted:hover {
  background: #524b44;
  border-color: #524b44;
}

/* Hero Section */
.hero {
  min-height: 600px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  background: var(--ink);
  color: #ffffff;
  padding: 64px max(5%, calc((100vw - 1300px) / 2));
  overflow: hidden;
  scroll-margin-top: var(--header-height, 90px);
}

.eyebrow {
  display: inline-block;
  font-size: 12px;
  letter-spacing: 2.4px;
  font-weight: 900;
  color: #ff916b;
}

.hero .hero-title,
.hero h1,
.section h2,
.story h2,
.order h2,
.visit-section h2 {
  font-family: Impact, 'Arial Narrow', sans-serif;
  font-stretch: condensed;
  font-weight: 900;
  line-height: 0.98;
  letter-spacing: 0.5px;
}

.hero .hero-title {
  font-size: clamp(56px, 6.3vw, 102px);
  margin: 22px 0;
}

.hero .hero-title em,
.hero h1 em,
.story h2 em {
  color: var(--orange);
  font-style: normal;
}

.hero p {
  max-width: 460px;
  font-size: 18.5px;
  line-height: 1.65;
  color: #e1d9d0;
}

.actions {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
  margin-top: 32px;
}

.textlink {
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 0.8px;
  transition: color 0.2s ease;
}

.hero-art {
  position: relative;
  height: 460px;
  display: grid;
  place-items: center;
}

.burger-emoji {
  font-size: clamp(190px, 24vw, 330px);
  filter: drop-shadow(0 28px 25px rgba(0, 0, 0, 0.6));
  transform: rotate(-10deg);
}

.roundel {
  position: absolute;
  top: 5px;
  right: 5%;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: var(--orange);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  transform: rotate(14deg);
  z-index: 1;
}

.roundel span {
  font-family: Impact, 'Arial Narrow', sans-serif;
  font-size: 44px;
  line-height: 1;
}

.roundel small {
  font-size: 11px;
  text-align: center;
  font-weight: bold;
  letter-spacing: 0.5px;
}

/* Ticker */
.ticker {
  background: var(--orange);
  color: #ffffff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px 20px;
  padding: 16px 12px;
  font-weight: 900;
  letter-spacing: 1.5px;
  font-size: 12px;
}

/* Sections */
.section {
  padding: 96px max(5%, calc((100vw - 1300px) / 2));
  scroll-margin-top: var(--header-height, 90px);
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
}

.orange {
  color: var(--orange);
}

.section h2,
.visit-section h2 {
  font-size: clamp(56px, 6.5vw, 96px);
  margin: 12px 0;
}

.section-heading p {
  max-width: 370px;
  color: var(--muted);
  line-height: 1.7;
  margin: 0;
}

/* Sticky Category Filter Bar & Menu */
.filters {
  position: sticky;
  top: var(--header-height, 90px);
  z-index: 850;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
  margin-bottom: 32px;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  padding: 14px max(5%, calc((100vw - 1300px) / 2));
  background: rgba(246, 241, 231, 0.96);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-top: 1px solid transparent;
  border-bottom: 1px solid #dfd5c5;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.filters.is-stuck {
  border-bottom-color: rgba(231, 72, 28, 0.4);
  box-shadow: 0 8px 22px rgba(23, 21, 19, 0.08);
}

.filters::-webkit-scrollbar {
  display: none;
}

.filters button {
  background: var(--card-cream);
  color: var(--ink);
  border: 1.5px solid #cfc5b6;
  border-radius: 3px;
  padding: 10px 18px;
  cursor: pointer;
  font-weight: 900;
  font-size: 12px;
  letter-spacing: 1px;
  text-transform: uppercase;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.filters button:hover {
  border-color: var(--ink);
  background: #efe7da;
}

.filters button.active {
  background: var(--ink);
  color: #ffffff;
  border-color: var(--ink);
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.menu-card {
  background: var(--card-cream);
  padding: 26px;
  min-height: 205px;
  border: 1px solid var(--border-warm);
  border-radius: 4px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.menu-card[hidden] {
  display: none;
}

.menu-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(23, 21, 19, 0.06);
}

.category {
  display: inline-block;
  color: var(--orange);
  font-size: 10.5px;
  letter-spacing: 2px;
  font-weight: 900;
  text-transform: uppercase;
}

.item-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  align-items: flex-start;
  margin: 14px 0 10px;
}

.item-top h3 {
  font-size: 21px;
  margin: 0;
  line-height: 1.2;
  letter-spacing: 0.01em;
}

.item-top strong {
  white-space: nowrap;
  color: var(--orange);
  font-size: 14.5px;
  font-weight: 800;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.menu-card p {
  color: #5d554e;
  line-height: 1.62;
  letter-spacing: 0.01em;
  font-size: 14px;
  margin: 0;
}

/* Upgrade Section Styling - Compact & Aligned */
.upgrade-section {
  margin-top: 52px;
  background: #efe5d5;
  border: 1.5px solid #dcd0bd;
  border-radius: 6px;
  padding: 28px;
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
}

.upgrade-section h3 {
  font-family: Impact, 'Arial Narrow', sans-serif;
  font-size: 24px;
  letter-spacing: 0.6px;
  margin: 0 0 16px;
  color: var(--ink);
}

.upgrade-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.upgrade-card {
  background: var(--card-cream);
  padding: 16px 20px;
  border: 1px solid var(--border-warm);
  border-radius: 4px;
}

.upgrade-card .item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin: 0;
}

.upgrade-card h4 {
  margin: 0;
  font-size: 16px;
  font-weight: 800;
}

.upgrade-card p {
  margin: 6px 0 0;
  font-size: 13.5px;
  color: #5d554e;
  line-height: 1.55;
}

/* Story Section */
.story {
  background: #e9dfcf;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
  padding: 96px max(5%, calc((100vw - 1300px) / 2));
  scroll-margin-top: var(--header-height, 90px);
}

.story-mark {
  height: 410px;
  background: var(--orange);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Impact, 'Arial Narrow', sans-serif;
  font-size: clamp(110px, 17vw, 250px);
  letter-spacing: -12px;
  transform: rotate(-3deg);
  border-radius: 4px;
  box-shadow: 0 18px 40px rgba(23, 21, 19, 0.14);
}

.story-mark span {
  color: #ffffff;
}

.story h2 {
  font-size: clamp(46px, 5vw, 78px);
  margin: 18px 0;
}

.story-copy p {
  line-height: 1.78;
  color: #4a423b;
  font-size: 15.5px;
  margin: 0 0 16px;
}

.story-est {
  display: inline-block;
  margin-top: 8px;
  font-weight: 900;
  font-size: 13px;
  letter-spacing: 2px;
  color: var(--ink);
}

/* Order CTA Section */
.order {
  text-align: center;
  background: #191715;
  color: #ffffff;
  padding: 100px 20px;
}

.order h2 {
  font-size: clamp(54px, 7.5vw, 110px);
  margin: 20px 0;
}

.order p {
  max-width: 580px;
  margin: 0 auto 32px;
  color: #ded4c9;
  line-height: 1.75;
}

.order small {
  display: block;
  color: #a8a09a;
  margin-top: 16px;
}

/* Visit & Contact Section (3-Column Balanced Cards) */
.visit-section {
  background: var(--cream);
  padding: 96px max(5%, calc((100vw - 1300px) / 2));
  border-top: 1px solid #dfd5c5;
  scroll-margin-top: var(--header-height, 90px);
}

.visit-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 44px;
}

.visit-intro {
  color: var(--muted);
  font-size: 15.5px;
  line-height: 1.65;
  margin: 0;
}

.visit-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  max-width: 1120px;
  margin: 0 auto;
  align-items: stretch;
}

.visit-card {
  background: var(--card-cream);
  border: 1px solid var(--border-warm);
  border-top: 4px solid var(--orange);
  border-radius: 6px;
  padding: 28px 26px;
  display: flex;
  flex-direction: column;
}

.visit-card h3 {
  color: var(--ink);
  font-family: Impact, 'Arial Narrow', sans-serif;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 0.6px;
  margin: 0 0 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border-warm);
}

.visit-card p {
  color: #5a524b;
  font-size: 14.5px;
  line-height: 1.72;
  letter-spacing: 0.015em;
  margin: 0;
}

.visit-card strong {
  color: var(--ink);
  font-weight: 800;
}

.hours-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.hours-list li {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  padding: 9px 0;
  border-bottom: 1px solid #ebe2d4;
  font-size: 14px;
  color: #5a524b;
  font-variant-numeric: tabular-nums;
}

.hours-list li:first-child {
  padding-top: 0;
}

.hours-list li:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.contact-link {
  color: var(--ink);
  font-weight: 700;
  text-decoration: underline;
  text-decoration-color: var(--orange);
  text-underline-offset: 3px;
  transition: color 0.2s ease;
}

.contact-link:hover {
  color: var(--orange);
}

/* Clean & Centered Footer */
.site-footer {
  background: #171513;
  color: #ffffff;
  padding: 56px 5% 28px;
  border-top: 1px solid #2c2824;
}

.footer-inner {
  max-width: 980px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20px;
}

.footer-brand img {
  width: 175px;
  height: auto;
  background: #fffaf1;
  padding: 8px 14px;
  border-radius: 5px;
  display: block;
}

.footer-tagline {
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 2.4px;
  color: #bfb6aa;
  margin: 0;
}

.footer-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px 30px;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.footer-links a {
  transition: color 0.2s ease;
}

.footer-links a:hover {
  color: var(--orange);
}

.sibling-concepts {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px 20px;
  padding: 12px 20px;
  background: #211e1b;
  border: 1px solid #332e29;
  border-radius: 6px;
}

.concepts-label {
  font-size: 11.5px;
  font-weight: 900;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--orange);
}

.concept-link {
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
  border-bottom: 1.5px solid var(--orange);
  padding-bottom: 2px;
  transition: color 0.2s ease;
}

.concept-link:hover {
  color: var(--orange);
}

.legal-links {
  display: flex;
  justify-content: center;
  gap: 22px;
  font-size: 12px;
  color: #b0a79b;
}

.legal-links a:hover {
  color: #ffffff;
}

.footer-bottom {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px 20px;
  flex-wrap: wrap;
  border-top: 1px solid #2d2925;
  padding-top: 22px;
  margin-top: 6px;
  color: #9e9589;
  font-size: 11px;
  letter-spacing: 0.7px;
}

/* Modal Popup Overlay */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.74);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 1000;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.modal-overlay.active {
  display: flex;
}

.modal-box {
  background: var(--card-cream);
  padding: 36px 30px;
  max-width: 460px;
  width: 100%;
  border: 3px solid var(--orange);
  border-radius: 6px;
  text-align: center;
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
}

.modal-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 2px;
  color: var(--orange);
  background: rgba(231, 72, 28, 0.12);
  padding: 5px 12px;
  border-radius: 3px;
  margin-bottom: 14px;
}

.modal-box h3 {
  font-family: Impact, 'Arial Narrow', sans-serif;
  font-size: 30px;
  letter-spacing: 0.5px;
  margin: 0 0 12px;
  color: var(--ink);
}

.modal-box p {
  color: #5d554e;
  font-size: 15px;
  line-height: 1.6;
  margin: 0 0 24px;
}

.modal-actions {
  display: flex;
  gap: 14px;
  justify-content: center;
}

.modal-actions .button {
  flex: 1;
}

/* ==========================================
   RESPONSIVE DESIGN FOR TABLETS & MOBILES
   ========================================== */

@media (max-width: 1024px) {
  .hero {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 50px 5%;
  }

  .hero p {
    margin-left: auto;
    margin-right: auto;
  }

  .actions {
    justify-content: center;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .story {
    grid-template-columns: 1fr;
    gap: 36px;
    padding: 70px 5%;
  }

  .story-mark {
    height: 280px;
  }
}

@media (max-width: 850px) {
  .visit-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  :root {
    --header-height: 64px;
  }

  .top {
    height: 64px;
    padding: 8px 4%;
    gap: 8px;
  }

  .brand img {
    width: 112px;
    max-height: 44px;
  }

  .top nav {
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.6px;
  }

  .top .button.small {
    padding: 8px 10px;
    font-size: 10.5px;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .hero {
    min-height: auto;
    padding: 40px 5%;
  }

  .hero .hero-title {
    font-size: clamp(42px, 11.5vw, 64px);
    margin: 16px 0;
  }

  .hero p {
    font-size: 16px;
  }

  .hero-art {
    height: 250px;
  }

  .burger-emoji {
    font-size: 175px;
  }

  .roundel {
    width: 104px;
    height: 104px;
  }

  .roundel span {
    font-size: 34px;
  }

  .section,
  .visit-section {
    padding: 56px 5%;
  }

  .section-heading {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .section h2,
  .visit-section h2,
  .order h2 {
    font-size: clamp(42px, 11.5vw, 62px);
  }

  /* Single-row horizontal sticky filter bar on mobile */
  .filters {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 8px;
    padding: 10px 5%;
    margin-top: 20px;
    margin-bottom: 22px;
  }

  .filters button {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 8px 14px;
    font-size: 11px;
  }

  .menu-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .menu-card {
    padding: 20px;
    min-height: auto;
  }

  .upgrade-section {
    padding: 20px;
    margin-top: 36px;
  }

  .visit-card {
    padding: 22px 20px;
  }

  .site-footer {
    padding: 44px 5% 24px;
  }

  .sibling-concepts {
    flex-direction: column;
    width: 100%;
    gap: 10px;
  }

  .footer-bottom {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 400px) {
  .brand img {
    width: 96px;
  }

  .top nav {
    gap: 9px;
    font-size: 10px;
  }

  .top .button.small {
    padding: 7px 8px;
    font-size: 9.5px;
  }
}
